DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PORT=3456
# 仅本地 FileStore 使用；生产配置 DATABASE_URL 后会忽略此文件数据
DB_PATH=C:/absolute/path/to/local-preview.json
# 已存在账号的最后登录时间最多每天落库一次；登录和权限判断仍立即生效
USER_LAST_SEEN_WRITE_INTERVAL_MS=86400000
# 仅供独立备份任务使用，不要配置到前端
BACKUP_DATABASE_URL=postgresql://backup_user:password@host/database?sslmode=require
BACKUP_PUBLIC_KEY_PATH=C:/absolute/path/to/schedule-backup-public.pem
BACKUP_PRIVATE_KEY_PATH=C:/absolute/path/to/schedule-backup-private.pem
